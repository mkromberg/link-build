 BuildExe;filename;type;flags;resource;icon;cmdline;details;buildfile

 filename←'C:\MYAPPD\MYAPP.exe'
 type←'StandaloneNativeExe'
 flags←8 ⍝ Runtime
 resource←''
 icon←'c:\MYAPPD\MYAPP.ico'
 cmdline←'MYAPP.exe MAXWS=1.2G MYAPP_FORMSIZE="1000 1600" AUTODPI=0'
 buildfile←GITPATH,'myapp/installer/MYAPP/MYAPP.exe'

 details←['Comments'        'MYAPP® for Dyalog APL'
          'CompanyName'     'MYAPP Inc.'
          'FileDescription' 'MYAPP® executable for Dyalog APL'
          'FileVersion'     (↑'Mmm YYYY'(1200⌶)1 ⎕DT'J')
          'ProductVersion'  (↑'Mmm YYYY'(1200⌶)1 ⎕DT'J')
          'LegalCopyright'  ('Copyright MYAPP Inc. ',⍕1⊃⎕TS)
          'ProductName'     'MYAPP® for Dyalog APL']

 :If 1=2 ⎕NQ'.' 'bind'filename type flags resource icon cmdline details
     ⎕←'Created executable with command line ',cmdline
     :If ⎕NEXISTS buildfile
         buildfile(⎕NCOPY⍠'IfExists' 'Replace')filename
         ⎕←'Also updated ',buildfile
     :EndIf
 :Else
     ⎕←'Build of ',buildfile,' failed.'
 :EndIf
