 BuildExe cfg;filename;type;flags;resource;icon;cmdline;details;buildfile;ver

 filename←cfg.filename
 type←cfg.type
 flags←8×cfg.runtime
 resource←cfg.resource
 icon←cfg.(configsource,'/',icon)
 cmdline←cfg.cmdline
 buildcopy←GITPATH,cfg.buildcopy
 ver←,↑'Mmm YYYY'(1200⌶)1 ⎕DT'J'

 details←['Comments'        cfg.details.Comments
          'CompanyName'     cfg.details.CompanyName
          'FileDescription' cfg.details.FileDescription
          'FileVersion'     ver
          'ProductVersion'  ver
          'LegalCopyright'  (cfg.details.LegalCopyright,' ',⍕1⊃⎕TS)
          'ProductName'     cfg.details.ProductName]

 :If 1=2 ⎕NQ'.' 'bind'filename type flags resource icon cmdline details
     ⎕←'Created ',((cfg.runtime)/'runtime '),'executable with command line ',cmdline
     :If ⎕NEXISTS buildcopy
         buildcopy(⎕NCOPY⍠'IfExists' 'Replace')filename
         ⎕←'Also updated ',buildfile
     :EndIf
 :Else
     ⎕←'Build of ',buildfile,' failed.'
 :EndIf
