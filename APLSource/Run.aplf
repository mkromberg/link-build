  Run;saved;m;link;ns;dir;names;times;parts;path;name;ext;z;⎕TRAP;norm;i;deleted;file;tgt
⍝ Patch, then "launch" workspace built by Build
⍝ Patching expunges names of source files deleted since the build, then fixes changed files

 ⎕TRAP←0 'C' '→ERROR'

 ⎕←'Setting up development environment - Patching and recreating Links'
 saved←13 ⎕NINFO ⎕WSID,('.dws'≢⎕C ¯4↑⎕wsid)/'.dws' ⍝ When the workspace was saved
 LINKS.preloaded←1                   ⍝ Flag them all as preloaded
 :If ∨/m←~⎕NEXISTS LINKS.dir
     ⎕←'*** WARNING: source folder(s) not found: ',⍕m/⎕SE.Link.Links.dir
     LINKS←(~m)/LINKS
 :EndIf

 norm←{{('/'=¯1↑⍵)↓⍵}⎕C'/'@('\'=⊢)⍵} ⍝ Compare paths regardless of slash style, case or trailing slash

 :For link :In LINKS
     (ns dir)←link.(ns dir)

     :If CONFIG.delete
         i←(norm¨GITREPOS.path)⍳⊂norm dir ⍝ Repo as it was at build time
     :AndIf i≤≢GITREPOS
         deleted←dir GitDeleted i⊃GITREPOS.hash
         :For file :In deleted
             (path name ext)←⎕NPARTS file
             :If (ext≡'.dyalog')∨'.apl'≡4↑ext ⍝ A source file that Link would have loaded
                 tgt←ns,(~link.flatten)/∊'.',¨'/'(≠⊆⊢)path ⍝ Subfolders are sub-namespaces unless flattened
                 :If (9=⎕NC tgt)∨(⊂tgt)∊,¨'#' '⎕SE'
                     :If 0≠(⍎tgt).⎕NC⊂name
                         z←(⍎tgt).⎕EX⊂name
                         ⎕←'Expunged ',tgt,'.',name,' (',file,' deleted)'
                     :EndIf
                 :EndIf
             :EndIf
         :EndFor
     :EndIf

     (names times)←0 13 ⎕NINFO⍠('Wildcard' 1)('Recurse' 1)⊢dir,'/*'
     parts←⎕NPARTS(times>saved)/names
     names←(m←((3⊃¨parts)∊⊂'.dyalog')∨(4↑¨3⊃¨parts)∊⊂'.apl')/2⊃¨parts

     :For (path name ext) :In m/parts
         ⎕←'Patched ',path,name,ext
         tgt←ns,(~link.flatten)/∊'.',¨'/'(≠⊆⊢)(≢dir)↓path ⍝ Subfolders are sub-namespaces unless flattened    
         :If ext≡'.apla'
             tgt ⎕SE.Link.Fix 1⊃⎕NGET(path,name,ext)1
         :Else
             2(⍎tgt).⎕FIX'file://',path,name,ext
         :EndIf
     :EndFor
     ⎕←''
     ⎕←'Re-establishing link: ',(⍕ns),' ←→ ',dir
     link←⎕NS ⎕OR 'link'
     link.⎕EX 'ns' 'dir'
     z←link ⎕SE.Link.Create ns dir
 :EndFor

 DEV←∨/'yY1'∊2 ⎕NQ'.' 'GetEnvironment' 'DEV'
 DEV∨←(⊂'Build')∊⎕SI ⍝ Also enter development mode if Run was called from Build
 :If DEV∧~⎕SYSTEM.Executable.Runtime
     ⎕←'      ',CONFIG.LX
 :Else
     :If 0≠≢RIDE
         3502⌶RIDE ⋄ 3502⌶1
         Warn'NB RIDE is enabled - disable before shipping!'
     :EndIf
     ⎕TRAP←0⍴⎕TRAP ⍝ Let the application take control
     #.⍎CONFIG.LX
     :If ⎕SYSTEM.Executable.Runtime
         ⎕OFF 
     :EndIf
 :EndIf
 →0

ERROR:
 ⎕TRAP←0 'S'
 'EF'⎕WC'Form'(CONFIG.PRODUCT,' Startup Error')('Size' 300 1000)('Coord' 'Pixel')
 'EF.TXT'⎕WC'Text'(⊂⍕⍪⎕DMX.DM)(10 10)('Font' 'APL385 Unicode')
 ⎕DQ'EF'
